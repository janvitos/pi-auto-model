{
  "name": "@janvitos/pi-auto-model",
  "version": "0.1.0",
  "description": "Route the first Pi prompt to one of two or three configured models.",
  "type": "module",
  "license": "MIT",
  "author": "janvitos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janvitos/pi-auto-model.git"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "model-router",
